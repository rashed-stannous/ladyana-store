{
  "rewrites": [
    {
      "source": "/((?!api/|assets/|sw\\.js$|manifest\\.webmanifest$|favicon\\.ico$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
